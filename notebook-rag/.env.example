OPENAI_API_KEY=REDACTED_OPENAI_API_KEY
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_EMBEDDING_MODEL=text-embedding-v4
DEFAULT_CHAT_MODEL=qwen-plus

DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

# ---- Storage（opendal）----
# notebook 元信息、原始文件、markdown 等存储在 OSS
OPENDAL_SCHEME=oss
OPENDAL_OSS_BUCKET=notebook-rag
OPENDAL_OSS_REGION=oss-cn-beijing
OPENDAL_OSS_ACCESS_KEY_ID=REDACTED_ACCESS_KEY_ID
OPENDAL_OSS_ACCESS_KEY_SECRET=REDACTED_ACCESS_KEY_SECRET
OPENDAL_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# ---- LanceDB 存储路径 ----
# 使用 OSS S3 兼容协议存储向量数据
LANCE_DB_URI=s3://notebook-rag
