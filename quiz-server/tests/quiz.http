### 

@base_url = http://localhost:8080/api
@quiz_id = test-quiz-001


### 

# Quiz API E2E Tests


### 


### 1. Health check - Server should be running

GET http://localhost:8080/api/quizzes?page=1&limit=1 HTTP/1.1


### 2. Get filter metadata - Should return available filter options

GET {{base_url}}/quizzes/filter-meta HTTP/1.1

> {%
  client.test("Filter meta response is valid", function () {
    var body = response.body;
    client.assert(body.types !== undefined, "types should exist");
    client.assert(body.classes !== undefined, "classes should exist");
    client.assert(body.units !== undefined, "units should exist");
    client.assert(body.sources !== undefined, "sources should exist");
    client.assert(body.years !== undefined, "years should exist");
  });
%}


### 3. List quizzes with pagination

GET {{base_url}}/quizzes?page=1&limit=10 HTTP/1.1

> {%
  client.test("Paginated response structure is correct", function () {
    var body = response.body;
    client.assert(body.data !== undefined, "data should exist");
    client.assert(typeof body.total === "number", "total should be a number");
    client.assert(typeof body.page === "number", "page should be a number");
    client.assert(typeof body.limit === "number", "limit should be a number");
    client.assert(
      typeof body.total_pages === "number",
      "total_pages should be a number",
    );
  });
%}


### 4. List quizzes - Page 2

GET {{base_url}}/quizzes?page=2&limit=5 HTTP/1.1

> {%
  client.test("Page 2 returns correct structure", function () {
    var body = response.body;
    client.assert(body.page === 2, "page should be 2");
    client.assert(body.limit === 5, "limit should be 5");
  });
%}


### 5. Filter quizzes by type

GET {{base_url}}/quizzes?types=A1&limit=20 HTTP/1.1


### 6. Filter quizzes by class

GET {{base_url}}/quizzes?classes=内科学&limit=20 HTTP/1.1


### 7. Filter quizzes by multiple criteria

GET {{base_url}}/quizzes?types=A1&classes=内科学&limit=10 HTTP/1.1


### 8. Search quizzes by keyword

GET {{base_url}}/quizzes/search?search=血液&page=1&limit=10 HTTP/1.1

> {%
  client.test("Search returns matching results", function () {
    var body = response.body;
    if (body.data.length > 0) {
      body.data.forEach(function (quiz) {
        var searchTerm = "血液";
        var matched =
          quiz.question.toLowerCase().includes(searchTerm) ||
          (quiz.answer && quiz.answer.toLowerCase().includes(searchTerm));
        client.assert(matched, "Quiz should contain search term: " + searchTerm);
      });
    }
  });
%}


### 9. Get random quizzes (default limit)

GET {{base_url}}/quizzes/random HTTP/1.1

> {%
  client.test("Random quizzes returns array", function () {
    var body = response.body;
    client.assert(Array.isArray(body), "Should return an array");
    client.assert(body.length <= 10, "Default limit should be 10");
  });
%}


### 10. Get random quizzes with custom limit

GET {{base_url}}/quizzes/random?limit=5 HTTP/1.1

> {%
  client.test("Random quizzes respects limit", function () {
    var body = response.body;
    client.assert(body.length <= 5, "Should respect custom limit of 5");
  });
%}


### 11. Get random quizzes with filters

GET {{base_url}}/quizzes/random?limit=3&types=A1 HTTP/1.1


### 12. Get quiz by ID

# First get a quiz ID from the list

GET {{base_url}}/quizzes?limit=1 HTTP/1.1

> {%
  client.global.set("quiz_id", response.body.data[0]?.id || "quiz-001");
%}


### 13. Get specific quiz by ID (using dynamic variable)

GET {{base_url}}/quizzes/{{quiz_id}} HTTP/1.1

> {%
  client.test("Get quiz by ID returns correct structure", function () {
    var body = response.body;
    client.assert(body.id !== undefined, "Quiz should have id");
    client.assert(body.question !== undefined, "Quiz should have question");
    client.assert(body.answer !== undefined, "Quiz should have answer");
    client.assert(body.type !== undefined, "Quiz should have type");
  });
%}


### 14. Get non-existent quiz (should return 404)

GET {{base_url}}/quizzes/non-existent-quiz-id HTTP/1.1

> {%
  client.test("Non-existent quiz returns 404", function () {
    client.assert(
      response.status === 404,
      "Should return 404 for non-existent quiz",
    );
  });
%}


### 15. Get quiz with invalid ID format

GET {{base_url}}/quizzes/invalid__id__format HTTP/1.1

> {%
  client.test("Invalid ID format is handled", function () {
    // Should either return 404 or the quiz if it exists
    client.assert(
      response.status === 404 || response.status === 200,
      "Should handle invalid ID gracefully",
    );
  });
%}


