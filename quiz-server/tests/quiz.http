    var body = response.body;
    client.assert(Array.isArray(body), "Should return an array of tags");
  });
%}


### 17. Get tags with limit

GET {{base_url}}/tags?limit=5 HTTP/1.1

> {%
  client.test("Tags respects limit", function () {
    var body = response.body;
    client.assert(body.length <= 5, "Should respect limit of 5");
  });
%}


### 18. Search tags

GET {{base_url}}/tags?q=低质量 HTTP/1.1


### 19. Get tags for a specific quiz

GET {{base_url}}/quizzes/{{quiz_id}}/tags HTTP/1.1

> {%
  client.test("Quiz tags returns array", function () {
    var body = response.body;
    client.assert(Array.isArray(body), "Should return an array");
  });
%}


### 20. Get tags for non-existent quiz

GET {{base_url}}/quizzes/non-existent-quiz/tags HTTP/1.1

> {%
  client.test("Tags for non-existent quiz returns empty array", function () {
    var body = response.body;
    client.assert(
      Array.isArray(body),
      "Should return an array (empty or with data)",
    );
  });
%}


### 21. Add tag to quiz

POST {{base_url}}/quizzes/{{quiz_id}}/tags HTTP/1.1
Content-Type: application/json

{
    "quiz_id": "{{quiz_id}}",
    "value": "important",
    "tag_type": "private"
}

> {%
  client.test("Add tag returns success", function () {
    var body = response.body;
    client.assert(body.success === true, "Should return success: true");
    client.assert(body.id !== undefined, "Should return tag id");
    client.global.set("new_tag_id", body.id);
  });
%}


### 22. Add another tag to quiz

POST {{base_url}}/quizzes/{{quiz_id}}/tags HTTP/1.1
Content-Type: application/json

{
    "quiz_id": "{{quiz_id}}",
    "value": "reviewed",
    "tag_type": "private"
}


### 23. Add tag with default type

POST {{base_url}}/quizzes/{{quiz_id}}/tags HTTP/1.1
Content-Type: application/json

{
    "quiz_id": "{{quiz_id}}",
    "value": "needs-review"
}

> {%
  client.test("Add tag with default type succeeds", function () {
    var body = response.body;
    client.assert(body.success === true, "Should succeed with default type");
  });
%}


### 24. Add tag to non-existent quiz (should fail gracefully)

POST {{base_url}}/quizzes/non-existent-quiz/tags HTTP/1.1
Content-Type: application/json

{
    "quiz_id": "non-existent-quiz",
    "value": "test-tag",
    "tag_type": "private"
}

> {%
  client.test("Add tag to non-existent quiz is handled", function () {
    // May return 404 or succeed depending on implementation
    client.assert(
      [200, 201, 404, 500].includes(response.status),
      "Should handle gracefully",
    );
  });
%}


### 25. Get tags after adding (verify tags exist)

GET {{base_url}}/quizzes/{{quiz_id}}/tags HTTP/1.1

> {%
  client.test("Tags were added successfully", function () {
    var body = response.body;
    client.assert(body.length >= 1, "Should have at least 1 tag after adding");
  });
%}


### 26. Delete tag

DELETE {{base_url}}/quizzes/{{quiz_id}}/tags/{{new_tag_id}} HTTP/1.1

> {%
  client.test("Delete tag returns success", function () {
    var body = response.body;
    client.assert(body.success === true, "Should return success: true");
  });
%}


### 27. Delete non-existent tag (should handle gracefully)

DELETE {{base_url}}/quizzes/{{quiz_id}}/tags/non-existent-tag-id HTTP/1.1

> {%
  client.test("Delete non-existent tag is handled", function () {
    // Should return error since tag doesn't exist
    client.assert(
      response.status !== 200,
      "Should not return success for non-existent tag",
    );
  });
%}


### 

# Edge Cases and Error Handling


### 


### 28. Invalid pagination - negative page

GET {{base_url}}/quizzes?page=-1&limit=10 HTTP/1.1

> {%
  client.test("Negative page is handled", function () {
    var body = response.body;
    client.assert(body.page >= 1, "Page should be normalized to at least 1");
  });
%}


### 29. Invalid pagination - page 0

GET {{base_url}}/quizzes?page=0&limit=10 HTTP/1.1

> {%
  client.test("Page 0 is handled", function () {
    var body = response.body;
    client.assert(body.page >= 1, "Page should be normalized to at least 1");
  });
%}


### 30. Limit exceeds maximum (100)

GET {{base_url}}/quizzes?page=1&limit=500 HTTP/1.1

> {%
  client.test("Excessive limit is capped", function () {
    var body = response.body;
    client.assert(body.limit <= 100, "Limit should be capped at 100");
  });
%}


### 31. Random limit exceeds maximum (50)

GET {{base_url}}/quizzes/random?limit=100 HTTP/1.1

> {%
  client.test("Random limit exceeds max is capped", function () {
    var body = response.body;
    client.assert(body.length <= 50, "Random limit should be capped at 50");
  });
%}


